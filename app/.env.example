# Copy this file to .env and fill in real values on the machine that runs the app.
# Never commit the .env file. None of these placeholders are real secrets.

PORT=8787
# Address printed in emails. Use https on a host you control before anyone relies on the links.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Where the SQLite database file is stored.
DATABASE_PATH=./var/strata.db

# Set to 1 only on a private machine so you can read outgoing mail in ./var/outbox.jsonl
DEV_MAILBOX=1

# Email sending. Leave SMTP_HOST empty until you have a mailbox.
# The app still writes every message to ./var/outbox.jsonl so nothing is lost.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Strata App <notices@example.com>

# Optional first platform-owner account, created on startup if both are set.
# Use a long password. This is not a live account until you choose one.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Platform owner

# Cookie Secure flag. Set to 1 when PUBLIC_BASE_URL starts with https://
COOKIE_SECURE=0

# Stripe is not used in this stage. Later stages accept test keys only (sk_test_ / pk_test_).
# Never put a live secret key here.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
